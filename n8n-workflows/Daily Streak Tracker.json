      "parameters": {
        "jsCode": "const today = $('Day Summary').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.Date);\nconst last = rows.length ? rows[rows.length - 1] : null;\nconst prevStreak = last ? Number(last.Streak) || 0 : 0;\nconst restUsed = rows.slice(-6).some(r => r['Rest day'] === 'Yes');\n\nlet streak, rest = 'No';\nif (today.worked === 'Yes') {\n  streak = prevStreak + 1;\n} else if (!restUsed && prevStreak > 0) {\n  streak = prevStreak;\n  rest = 'Yes';\n} else {\n  streak = 0;\n}\n\nreturn [{ json: {\n  'Date': today.date,\n  'Worked': today.worked,\n  'Commits': today.commits,\n  'Rest day': rest,\n  'Streak': streak,\n  'Latest commit message': today.latest\n}}];"
      },
